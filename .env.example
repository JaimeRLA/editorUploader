# Copia este fichero como .env. Todo es opcional: los valores de abajo son los de por defecto.
# Lo específico de cada canal (temática, fuentes, edición, subida) va en channels/<id>/channel.toml.

# --- Modelos ------------------------------------------------------------------
# Modelo de Ollama que elige los momentos. Con Ollama actualizado, qwen3.5:9b es mejor.
OLLAMA_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434
# Whisper: large-v3-turbo (rápido y preciso) o large-v3 (algo más preciso y lento)
WHISPER_MODEL=large-v3-turbo
# auto | cuda | cpu
WHISPER_DEVICE=auto
# auto (NVENC si hay GPU NVIDIA, si no libx264) | h264_nvenc | libx264
VIDEO_ENCODER=auto

# --- YouTube ----------------------------------------------------------------
# Cliente OAuth "Aplicación de escritorio" (ver README). Uno solo para todos los canales.
YOUTUBE_CLIENT_SECRETS=credentials/client_secret.json

# --- Rutas --------------------------------------------------------------------
CHANNELS_DIR=channels
OUTPUT_DIR=output
# Vídeos descargados, transcripciones y análisis (se reutilizan entre canales y ejecuciones)
WORK_DIR=work
# Música global por ambiente (cada canal puede tener la suya en channels/<id>/music/)
MUSIC_DIR=music
